# Backup tooling for the nightly pg_dump and WAL archive CronJobs.
#
# postgres:18-alpine ships pg_dump but not aws-cli/openssl/bash. Installing
# them at runtime forced the jobs to run as root (Semgrep
# run-as-non-root-unsafe-value). Bake them into the image instead and run the
# jobs as the same numeric UID as the postgres StatefulSet (10001), which is
# required to read the fsGroup=10001 WAL PVC.
# Тег + digest: Renovate обновляет digest, а свежая база приносит актуальный gosu
# (Go stdlib CVE из Trivy #1784–#1844 живут в gosu внутри postgres-образа).
FROM docker.io/library/postgres:18-alpine@sha256:ff64c9e3bdf8e2120107d3559de8db314e8305f7e38c5105903c6295876738ff

# apk upgrade: postgres:18-alpine и aws-cli тянут libssl3/libcrypto3, а на момент
# сборки в репозитории уже лежала исправленная 3.5.9-r1 (Trivy: 5 CVE в 3.5.9-r0).
RUN apk upgrade --no-cache && \
  apk add --no-cache aws-cli bash openssl

# AWS CLI writes its cache under $HOME; /tmp is mounted as an emptyDir in the
# CronJobs because readOnlyRootFilesystem=true.
ENV HOME=/tmp

USER 10001:10001