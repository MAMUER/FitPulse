import http from 'k6/http';
import { check, sleep, group } from 'k6';
import { Trend, Counter, Rate } from 'k6/metrics';

const loginDuration = new Trend('login_duration');
const apiErrors = new Counter('api_errors_total');
const errorRate = new Rate('errors');

// Supports the units k6 itself accepts: "30s", "1m", "1m30s", "2h".
function parseDuration(value) {
    const units = { h: 3600, m: 60, s: 1 };
    const text = String(value).toLowerCase();
    const re = /(\d+)\s*([hms])/g;
    let total = 0;
    let matched = false;
    let m = re.exec(text);
    while (m !== null) {
        total += Number(m[1]) * units[m[2]];
        matched = true;
        m = re.exec(text);
    }
    return matched && total > 0 ? total : 120;
}

function buildStages(vus, totalSeconds) {
    const ramp = Math.min(30, Math.max(5, Math.round(totalSeconds * 0.25)));
    const hold = Math.max(10, totalSeconds - ramp * 2);
    return [
        { duration: `${ramp}s`, target: Math.max(1, Math.round(vus * 0.4)) },
        { duration: `${hold}s`, target: vus },
        { duration: `${ramp}s`, target: 0 },
    ];
}

// DURATION / VUS come from the wrapper (scripts/load-test.py --duration/--vus).
const VUS = Math.max(1, Number(__ENV.K6_VUS) || 50);
const TOTAL_SECONDS = parseDuration(__ENV.K6_DURATION || '2m');

export const options = {
    insecureSkipTLSVerify: __ENV.INSECURE_SKIP_TLS_VERIFY === 'true',
    stages: buildStages(VUS, TOTAL_SECONDS),
    thresholds: {
        http_req_duration: [
            'p(95)<2000',
            'p(99)<5000',
            'p(99.9)<10000',
        ],
        'api_errors_total': ['count<6000'],
    },
};

const BASE_URL = __ENV.BASE_URL || 'https://localhost:8443';
// Токен логина приходит в HttpOnly-cookie, а не в теле ответа.
const ACCESS_COOKIE = 'fitpulse-access-token';
const ADMIN_EMAIL = __ENV.SEED_ADMIN_EMAIL || '';
const ADMIN_PASSWORD = __ENV.SEED_ADMIN_PASSWORD || '';
const TEST_PASSWORD = __ENV.TEST_PASSWORD || 'LoadTest123!';

function login(email, password) {
    return http.post(
        `${BASE_URL}/api/v1/login`,
        JSON.stringify({ email, password }),
        { headers: { 'Content-Type': 'application/json' }, timeout: '10s' }
    );
}

function extractAccessToken(res) {
    const cookies = res.cookies[ACCESS_COOKIE];
    if (cookies && cookies.length > 0) {
        return cookies[0].value;
    }
    return '';
}

export function setup() {
    let email = ADMIN_EMAIL;
    let password = ADMIN_PASSWORD;

    // Если админ не задан — регистрируем нового пользователя (в проде такому
    // пользователю нужно подтверждение email, поэтому основной путь — SEED_ADMIN).
    if (!email || !password) {
        const rid = Math.random().toString(36).substring(2, 8);
        email = `loadtest-${rid}@example.com`;
        password = TEST_PASSWORD;
        const reg = http.post(
            `${BASE_URL}/api/v1/register`,
            JSON.stringify({
                email,
                password,
                full_name: 'Load Test User',
                role: 'client',
            }),
            { headers: { 'Content-Type': 'application/json' }, timeout: '10s' }
        );
        check(reg, { 'register success': (r) => r.status === 200 });
    }

    const start = new Date();
    const loginRes = login(email, password);
    loginDuration.add(new Date() - start);
    check(loginRes, { 'login success': (r) => r.status === 200 });

    const token = extractAccessToken(loginRes);
    if (!token) {
        throw new Error(
            `login failed: HTTP ${loginRes.status} (нет cookie ${ACCESS_COOKIE}; задан ли SEED_ADMIN?)`
        );
    }

    // Заполняем профиль (идемпотентно, 401 не валит setup).
    http.put(
        `${BASE_URL}/api/v1/profile`,
        JSON.stringify({
            full_name: 'Load Test User',
            age: 30,
            gender: 'male',
            height_cm: 180,
            weight_kg: 75.5,
            fitness_level: 'intermediate',
            goals: ['endurance', 'weight_loss'],
            contraindications: [],
            nutrition: 'balanced',
            sleep_hours: 7.5,
        }),
        {
            headers: {
                'Content-Type': 'application/json',
                Cookie: `${ACCESS_COOKIE}=${token}`,
            },
            timeout: '10s',
        }
    );

    return { token };
}

const PROTECTED_PATHS = [
    '/api/v1/profile',
    '/api/v1/nutrition/meals',
    '/api/v1/calendar/events',
    '/api/v1/dishes',
    '/api/v1/friends',
    '/api/v1/leaderboard',
    '/api/v1/health/body-composition',
    '/api/v1/health/menstrual-cycles',
];

export default function (data) {
    const headers = { Cookie: `${ACCESS_COOKIE}=${data.token}` };

    group('Health Check', () => {
        const res = http.get(`${BASE_URL}/healthz`, { timeout: '10s' });
        check(res, { 'health ok': (r) => r.status === 200 }) ||
            (apiErrors.add(1), errorRate.add(1));
    });
    sleep(0.3);

    for (const path of PROTECTED_PATHS) {
        group(`GET ${path}`, () => {
            const res = http.get(`${BASE_URL}${path}`, { headers, timeout: '10s' });
            check(res, {
                [`${path} -> 200`]: (r) => r.status === 200,
            }) || (apiErrors.add(1), errorRate.add(1));
        });
        sleep(0.2);
    }

    sleep(0.5);
}