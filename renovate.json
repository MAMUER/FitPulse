{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "enabledManagers": [
    "regex"
  ],
  "regex": [
    {
      "fileMatch": [
        "\\.github/workflows/ci\\.yml$"
      ],
      "matchStrings": [
        "GO_VERSION:\\s*(?P<quote>[\"']?)(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\g<quote>"
      ],
      "depName": "golang",
      "datasource": "docker",
      "versioning": "semver",
      "depType": "toolchain"
    },
    {
      "fileMatch": [
        "\\.github/workflows/ci\\.yml$"
      ],
      "matchStrings": [
        "PYTHON_BLACK_VERSION:\\s*\"(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "depName": "black",
      "datasource": "pypi",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "\\.github/workflows/ci\\.yml$"
      ],
      "matchStrings": [
        "node-version:\\s*[\"'](?P<currentValue>[0-9]+)[\"']"
      ],
      "depName": "node",
      "datasource": "node",
      "versioning": "node"
    },
    {
      "fileMatch": [
        "\\.github/workflows/ci\\.yml$"
      ],
      "matchStrings": [
        "version:\\s*v(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "trivy",
      "datasource": "github-releases",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^Makefile$"
      ],
      "matchStrings": [
        "^GO_VERSION\\s*:=\\s*(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)$"
      ],
      "depName": "golang",
      "datasource": "docker",
      "versioning": "semver",
      "depType": "toolchain"
    },
    {
      "fileMatch": [
        "^Makefile$"
      ],
      "matchStrings": [
        "gci@v(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "daixiang0/gci",
      "datasource": "github-releases",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^Makefile$"
      ],
      "matchStrings": [
        "golangci-lint@v(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "golangci/golangci-lint",
      "datasource": "github-releases",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^go\\.mod$"
      ],
      "matchStrings": [
        "^go\\s+(?P<currentValue>[0-9]+\\.[0-9]+(\\.[0-9]+)?)$"
      ],
      "depName": "golang",
      "datasource": "docker",
      "versioning": "semver",
      "depType": "toolchain"
    },
    {
      "fileMatch": [
        "^scripts/ci/security\\.sh$"
      ],
      "matchStrings": [
        "semgrep==(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "semgrep",
      "datasource": "pypi",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^scripts/ci/(ci-helpers|lint|security)\\.sh$"
      ],
      "matchStrings": [
        "golangci-lint@v(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "golangci/golangci-lint",
      "datasource": "github-releases",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^scripts/ci/security\\.sh$"
      ],
      "matchStrings": [
        "cosign/v2/cmd/cosign@v(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "sigstore/cosign",
      "datasource": "github-releases",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^scripts/ci/ci-helpers\\.sh$"
      ],
      "matchStrings": [
        "hadolint/hadolint:v(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "hadolint/hadolint",
      "datasource": "docker",
      "versioning": "semver"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "golang"
      ],
      "groupName": "Go toolchain",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": [
        "trivy"
      ],
      "groupName": "Trivy",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": [
        "daixiang0/gci",
        "golangci/golangci-lint"
      ],
      "groupName": "Go tools",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": [
        "black",
        "semgrep"
      ],
      "groupName": "Python tools",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": [
        "sigstore/cosign",
        "hadolint/hadolint"
      ],
      "groupName": "Security tools",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    }
  ]
}