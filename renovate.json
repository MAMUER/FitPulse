{
  "extends": [
    "config:base"
  ],
  "enabledManagers": [
    "regex",
    "pip_requirements",
    "dockerfile",
    "kubernetes"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "\\.github/workflows/ci\\.yml$"
      ],
      "matchStrings": [
        "GO_VERSION:\\s*[\"']?(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)[\"']?"
      ],
      "depName": "golang",
      "datasource": "docker",
      "versioning": "semver",
      "depType": "toolchain"
    },
    {
      "fileMatch": [
        "\\.github/workflows/ci\\.yml$"
      ],
      "matchStrings": [
        "PYTHON_BLACK_VERSION:\\s*\"(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "depName": "black",
      "datasource": "pypi",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "\\.github/workflows/ci\\.yml$"
      ],
      "matchStrings": [
        "node-version:\\s*[\"'](?P<currentValue>[0-9]+)[\"']"
      ],
      "depName": "node",
      "datasource": "node",
      "versioning": "node"
    },
    {
      "fileMatch": [
        "\\.github/workflows/ci\\.yml$"
      ],
      "matchStrings": [
        "version:\\s*v(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "trivy",
      "datasource": "github-releases",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^Makefile$"
      ],
      "matchStrings": [
        "(?m)^GO_VERSION\\s*:=\\s*(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)$"
      ],
      "depName": "golang",
      "datasource": "docker",
      "versioning": "semver",
      "depType": "toolchain"
    },
    {
      "fileMatch": [
        "^Makefile$"
      ],
      "matchStrings": [
        "gci@v(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "daixiang0/gci",
      "datasource": "github-releases",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^Makefile$"
      ],
      "matchStrings": [
        "golangci-lint@v(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "golangci/golangci-lint",
      "datasource": "github-releases",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^go\\.mod$"
      ],
      "matchStrings": [
        "(?m)^go\\s+(?P<currentValue>[0-9]+\\.[0-9]+(\\.[0-9]+)?)$"
      ],
      "depName": "golang",
      "datasource": "docker",
      "versioning": "semver",
      "depType": "toolchain"
    },
    {
      "fileMatch": [
        "^\\.github/workflows/ci\\.yml$"
      ],
      "matchStrings": [
        "semgrep==(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "semgrep",
      "datasource": "pypi",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^scripts/ci/security\\.sh$"
      ],
      "matchStrings": [
        "checkov==(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "checkov",
      "datasource": "pypi",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^scripts/ci/(ci-helpers|lint|security)\\.sh$"
      ],
      "matchStrings": [
        "golangci-lint@v(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "golangci/golangci-lint",
      "datasource": "github-releases",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^scripts/ci/security\\.sh$"
      ],
      "matchStrings": [
        "sigstore/cosign v(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "sigstore/cosign",
      "datasource": "github-releases",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^scripts/ci/security\\.sh$"
      ],
      "matchStrings": [
        "KUBESCAPE_VERSION:-v?(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "kubescape",
      "datasource": "github-releases",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^scripts/ci/security\\.sh$"
      ],
      "matchStrings": [
        "KUBE_BENCH_VERSION:-v?(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "aquasecurity/kube-bench",
      "datasource": "github-releases",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^scripts/ci/security\\.sh$"
      ],
      "matchStrings": [
        "TRUFFLEHOG_VERSION:-[\"']?v?(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "trufflesecurity/trufflehog",
      "datasource": "github-releases",
      "versioning": "semver"
    },
    {
      "fileMatch": [
        "^scripts/ci/ci-helpers\\.sh$"
      ],
      "matchStrings": [
        "hadolint/hadolint:v(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depName": "hadolint/hadolint",
      "datasource": "docker",
      "versioning": "semver"
    },
    {
      "customType": "regex",
      "fileMatch": [
        "^scripts/ci/build-push\\.sh$"
      ],
      "matchStrings": [
        "OPEN_WEARABLES_REF:-[\"']?(?P<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)[\"']?\\}"
      ],
      "depName": "the-momentum/open-wearables",
      "datasource": "github-tags",
      "versioning": "semver",
      "depType": "upstream"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "golang"
      ],
      "groupName": "Go toolchain",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": [
        "trivy"
      ],
      "groupName": "Trivy",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": [
        "daixiang0/gci",
        "golangci/golangci-lint"
      ],
      "groupName": "Go tools",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": [
        "black",
        "semgrep",
        "checkov"
      ],
      "groupName": "Python tools",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": [
        "sigstore/cosign",
        "hadolint/hadolint",
        "kubescape",
        "trufflesecurity/trufflehog",
        "aquasecurity/kube-bench"
      ],
      "groupName": "Security tools",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": [
        "the-momentum/open-wearables"
      ],
      "groupName": "Open Wearables (upstream)",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": [
        "postgres"
      ],
      "groupName": "Postgres base image (pgsodium)",
      "automerge": false,
      "minimumReleaseAge": "7 days",
      "pinDigests": true
    }
  ]
}