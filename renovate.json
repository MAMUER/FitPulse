{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "enabledManagers": [
    "regex"
  ],
  "ignorePresets": [
    "config:base"
  ],
  "regex": [
    {
      "fileMatch": [
        "\\.github/workflows/ci\\.yml$"
      ],
      "matchStrings": [
        "GO_VERSION: \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "depName": "golang",
      "datasource": "docker",
      "versioning": "semver",
      "depType": "toolchain"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "golang"
      ],
      "groupName": "Go toolchain",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    }
  ]
}